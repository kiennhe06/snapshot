rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // User profiles
    match /users/{uid} {
      allow read: if signedIn();
      // Owner writes their own profile. Counts (followers/following/posts) may be
      // bumped by others via increment — allowed here for simplicity; tighten
      // with Cloud Functions in a later phase.
      allow create, update: if signedIn();
      allow delete: if signedIn() && request.auth.uid == uid;

      // Login history / devices — private to the owner.
      match /sessions/{sessionId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      // Follow edges.
      match /following/{targetUid} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }
      match /followers/{followerUid} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == followerUid;
      }

      // Favorites (close friends) — private to the owner.
      match /favorites/{targetUid} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      // Bookmarks + collections + block/mute/restrict — private to the owner.
      match /saved/{postId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      match /collections/{collectionId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      match /blocked/{targetUid} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      match /muted/{targetUid} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      match /restricted/{targetUid} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      // Story highlights — owner writes, anyone signed in can view.
      match /highlights/{id} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Username uniqueness index.
    match /usernames/{username} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // Posts
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.authorId == request.auth.uid;
      // Author can edit anything; anyone signed in may change only the
      // like/comment counters (needed for like/unlike from the feed).
      allow update: if signedIn() && (
        resource.data.authorId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['likesCount', 'commentsCount'])
      );

      match /likes/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }
      match /comments/{commentId} {
        function postAuthor() {
          return get(/databases/$(database)/documents/posts/$(postId)).data.authorId;
        }
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid;
        // Comment author or the post author can edit/delete; anyone signed in
        // may change only likesCount (comment like), and the post author may
        // toggle the 'pinned' flag.
        allow update: if signedIn() && (
          resource.data.authorId == request.auth.uid
          || postAuthor() == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['likesCount'])
          || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['replyCount'])
        );
        allow delete: if signedIn() && (
          resource.data.authorId == request.auth.uid
          || postAuthor() == request.auth.uid
        );

        match /likes/{uid} {
          allow read: if signedIn();
          allow write: if signedIn() && request.auth.uid == uid;
        }
      }
    }

    // Stories (24h). Audience is filtered client-side.
    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.authorId == request.auth.uid;
      // Author edits anything; anyone signed in may bump only viewsCount.
      allow update: if signedIn() && (
        resource.data.authorId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['viewsCount'])
      );

      // Who viewed (each viewer writes their own doc).
      match /views/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }
      // Sticker aggregates + responses (poll/slider/question).
      match /aggregates/{stickerId} {
        allow read, write: if signedIn();
      }
      match /responses/{responseId} {
        allow read, write: if signedIn();
      }
    }

    // Reports — anyone signed in can file; only backend/admin reads.
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
