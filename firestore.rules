rules_version = '2';

// Phase 1 rules: a user can read/write only their own profile and sessions.
// Public read of profiles is allowed so other users can be viewed later.
// Tighten/extend these as posts, feeds, chats are added in later phases.
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Login history / devices — private to the owner.
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Username uniqueness index (created via transaction later).
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
